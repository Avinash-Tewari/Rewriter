# Copy values into your environment. Never put a real key in source files.
# PowerShell:  $env:GROQ_API_KEY = "gsk_..."
# cmd:         set GROQ_API_KEY=gsk_...
# bash:        export GROQ_API_KEY=gsk_...

GROQ_API_KEY=
REWRITER_MODEL=llama-3.3-70b-versatile
REWRITER_BASE_URL=https://api.groq.com/openai/v1

# OPENAI_API_KEY, OPENAI_MODEL, and OPENAI_BASE_URL are also accepted
# if you want to use OpenAI instead.
